rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner() {
      return isSignedIn()
        && request.auth.token.email == 'tanadaniellemak@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidTutorialLesson(data) {
      return data.keys().hasAll([
          'lessonId',
          'ownerId',
          'ownerEmail',
          'orderIndex',
          'title',
          'summary',
          'notes',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lessonId',
          'ownerId',
          'ownerEmail',
          'orderIndex',
          'title',
          'summary',
          'notes',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.lessonId)
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.ownerEmail is string && data.ownerEmail.size() <= 200 && data.ownerEmail == 'tanadaniellemak@gmail.com'
        && data.orderIndex is number
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400
        && data.notes is string && data.notes.size() <= 8000
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /tutorialLessons/{lessonId} {
      allow get: if isVerifiedOwner()
        && isValidId(lessonId)
        && existing().ownerEmail == 'tanadaniellemak@gmail.com';

      allow list: if isVerifiedOwner()
        && resource.data.ownerEmail == 'tanadaniellemak@gmail.com';

      allow create: if isVerifiedOwner()
        && isValidId(lessonId)
        && isValidTutorialLesson(incoming())
        && incoming().lessonId == lessonId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner()
        && isValidId(lessonId)
        && isValidTutorialLesson(incoming())
        && incoming().lessonId == existing().lessonId
        && incoming().ownerId == existing().ownerId
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'summary',
            'notes',
            'completed',
            'orderIndex',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedOwner()
        && isValidId(lessonId)
        && existing().ownerEmail == 'tanadaniellemak@gmail.com';
    }
  }
}
